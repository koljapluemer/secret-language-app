{
  "name": "the-secret-language-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:secret": "vite --mode secret",
    "dev:cram": "vite --mode cram",
    "build": "vue-tsc -b && vite build",
    "build:secret": "vue-tsc -b && vite build --mode secret",
    "build:cram": "vue-tsc -b && vite build --mode cram",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "test": "vitest run --silent --reporter=dot",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@langchain/openai": "^1.6.0",
    "@sgratzl/chartjs-chart-boxplot": "^4.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.6",
    "dexie-cloud-addon": "^4.4.15",
    "langchain": "^1.5.14",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.46",
    "eslint": "^10.11.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "flush-promises": "^1.0.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
